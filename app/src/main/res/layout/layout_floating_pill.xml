<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pillRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Handle & Icon -->
    <ImageView
        android:id="@+id/ivPillDragHandle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_navigation"
        android:contentDescription="Drag handle" />

    <!-- Status dot / Label -->
    <TextView
        android:id="@+id/tvPillStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:text="Nav"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Button Piccolo (Mode 1) -->
    <TextView
        android:id="@+id/btnPillPiccolo"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Piccolo"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <!-- Button Intero (Mode 3) -->
    <TextView
        android:id="@+id/btnPillGrande"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Intero"
        android:textColor="#00B0FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Button Semplice (Mode 2) -->
    <TextView
        android:id="@+id/btnPillSemplice"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Semplice"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Button Off (Mode 1) -->
    <TextView
        android:id="@+id/btnPillOff"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Off"
        android:textColor="@color/status_red"
        android:textSize="11sp" />

    <!-- Button Voice (Mute/Unmute) -->
    <TextView
        android:id="@+id/btnPillVoice"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Voce"
        android:textColor="#00E676"
        android:textSize="11sp" />

</LinearLayout>
